Algoritmo IntercambiarValores
	
	Definir a Como Entero;
	Definir b Como Entero;
	Definir C Como Entero;
	
	
	Escribir "Cunato Vale A";
	Leer a;
	
	Escribir "Cunato Vale B";
	Leer b;
	
	c <- a;
	a <- b;
	b <- c;
	
	Escribir "ahora A vale: a" a;
	Escribir "ahora B vale: a" b;
	
	
	
	
	
	
	
FinAlgoritmo
